DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/tienda_ropa
SECRET_KEY=CAMBIAR_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Correos de demostración con destino fijo (Railway Hobby usa HTTPS).
# La clave real se guarda en .env o en las variables privadas de Railway.
# SMTP permanece como proveedor por defecto hasta configurar MAIL_PROVIDER.
MAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=StyleAR <onboarding@resend.dev>
# Usar el correo con el que se registró la cuenta de Resend; nunca dejar vacío.
MAIL_TO_OVERRIDE=

# IA para interpretar reportes/asistente y generar embeddings de recomendaciones.
# RULES usa lógica local cuando aplica.
# GEMINI usa API key de Google AI Studio.
# VERTEX usa Google Cloud ADC/service account.
AI_REPORTS_PROVIDER=GEMINI
AI_ASSISTANT_PROVIDER=GEMINI
AI_RECOMMENDATIONS_PROVIDER=GEMINI
GEMINI_API_KEY=CAMBIAR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
VERTEX_PROJECT_ID=project-bd5f6b19-186e-41b9-86e
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005


# CU16–CU20: conexiones externas. Valores reales únicamente en .env privado.
FRONTEND_URL=http://localhost:4200
OPENROUTE_API_KEY=
# Simulaciones explícitas; no representa una conexión bancaria.
STYLEAR_PAGOS_PRUEBA=1
# Sustituir 1 por el ID real de la empresa. No reutilizar claves entre empresas.
STYLEAR_PAGOS_1_STRIPE_SECRET_KEY=
STYLEAR_PAGOS_1_STRIPE_WEBHOOK_SECRET=
# Firebase: ID del proyecto y ruta al JSON privado de cuenta de servicio del servidor.
STYLEAR_FIREBASE_PROJECT_ID=
STYLEAR_FIREBASE_CREDENTIALS=
# BCP: pendiente de habilitación, contrato y documentación de la API del banco.
# No hay un endpoint bancario ni credenciales predeterminadas de producción.
